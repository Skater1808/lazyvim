{
  "Function": {
    "prefix": "fn",
    "body": [
      "pub fn ${1:name}(${2:args}) -> ${3:()} {",
      "\t${0}",
      "}"
    ],
    "description": "Öffentliche Funktion"
  },
  "Async function": {
    "prefix": "afn",
    "body": [
      "pub async fn ${1:name}(${2:args}) -> ${3:()} {",
      "\t${0}",
      "}"
    ],
    "description": "Asynchrone Funktion"
  },
  "Main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t${0}",
      "}"
    ],
    "description": "main-Funktion"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "#[derive(Debug, Clone)]",
      "pub struct ${1:Name} {",
      "\tpub ${2:field}: ${3:String},",
      "}"
    ],
    "description": "Struct mit Derives"
  },
  "Impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Name} {",
      "\tpub fn new(${2:args}) -> Self {",
      "\t\tSelf {",
      "\t\t\t${3:field}: ${4:value},",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Impl-Block mit Konstruktor"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "#[derive(Debug, Clone, Copy, PartialEq, Eq)]",
      "pub enum ${1:Name} {",
      "\t${2:Variant},",
      "}"
    ],
    "description": "Enum mit Derives"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:Pattern} => ${3:result},",
      "\t_ => ${0:todo!()},",
      "}"
    ],
    "description": "Match-Ausdruck"
  },
  "Test": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn ${1:test_name}() {",
      "\t${2:assert_eq!(1 + 1, 2);}",
      "}"
    ],
    "description": "Unit-Test"
  },
  "Println": {
    "prefix": "println",
    "body": [
      "println!(\"${1:message}\");"
    ],
    "description": "Ausgabe mit println!"
  },
  "Iterator map": {
    "prefix": "iter",
    "body": [
      "${1:items}.iter().map(|${2:item}| {",
      "\t${0}",
      "}).collect::<Vec<_>>()"
    ],
    "description": "Iterator mit map und collect"
  },
  "Result function": {
    "prefix": "res",
    "body": [
      "fn ${1:name}(${2:args}) -> Result<${3:()}, Box<dyn std::error::Error>> {",
      "\t${4:Ok(())}",
      "}"
    ],
    "description": "Funktion mit Result-Rückgabe"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "pub trait ${1:Name} {",
      "\tfn ${2:method}(&self) -> ${3:()};",
      "}"
    ],
    "description": "Trait definieren"
  },
  "Use": {
    "prefix": "use",
    "body": [
      "use ${1:std::collections::HashMap};"
    ],
    "description": "Use-Deklaration"
  }
}
