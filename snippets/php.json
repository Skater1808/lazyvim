{
  "PHP file": {
    "prefix": "php",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "${0}"
    ],
    "description": "PHP-Datei mit strict_types"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:args}): ${3:void}",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Funktion deklarieren"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}",
      "{",
      "\tpublic function __construct(",
      "\t\tprivate readonly ${2:string} \\$${3:name},",
      "\t) {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Klasse mit Constructor Promotion"
  },
  "Foreach": {
    "prefix": "foreach",
    "body": [
      "foreach (\\$${1:items} as \\$${2:key} => \\$${3:value}) {",
      "\t${0}",
      "}"
    ],
    "description": "Foreach-Schleife"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "If-Block"
  },
  "Try catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1}",
      "} catch (${2:Throwable} \\$${3:e}) {",
      "\tthrow \\$${3:e};",
      "}"
    ],
    "description": "Try/Catch-Block"
  },
  "PDO connection": {
    "prefix": "pdo",
    "body": [
      "\\$${1:pdo} = new PDO(",
      "\t\"mysql:host=${2:localhost};dbname=${3:database};charset=utf8mb4\",",
      "\t\"${4:root}\",",
      "\t\"${5:password}\",",
      "\t[PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],",
      ");"
    ],
    "description": "PDO-Verbindung"
  },
  "Echo": {
    "prefix": "echo",
    "body": [
      "echo ${1:expression};"
    ],
    "description": "Ausgabe mit echo"
  },
  "JSON encode": {
    "prefix": "json",
    "body": [
      "json_encode(\\$${1:data}, JSON_THROW_ON_ERROR)"
    ],
    "description": "Daten als JSON kodieren"
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "return match (\\$${1:value}) {",
      "\t${2:1} => ${3:'one'},",
      "\tdefault => ${4:null},",
      "};"
    ],
    "description": "PHP-8-Match-Ausdruck"
  },
  "Namespace": {
    "prefix": "ns",
    "body": [
      "namespace ${1:App};"
    ],
    "description": "Namespace deklarieren"
  },
  "Require once": {
    "prefix": "req",
    "body": [
      "require_once __DIR__ . '/${1:file}.php';"
    ],
    "description": "Datei einbinden"
  }
}
