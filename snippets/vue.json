      "",
      "<template>",
      "\t<div class=\"${2:container}\">",
      "\t\t${0}",
      "\t</div>",
      "</template>",
      "",
      "<style scoped>",
      "\t.${2:container} {",
      "\t\t${3}",
      "\t}",
      "</style>"
    ],
    "description": "Vue Single File Component"
  },
  "Script setup": {
    "prefix": "script",
    "body": [
      "<script setup lang=\"ts\">",
      "\t${0}",
      "</script>"
    ],
    "description": "Script-setup-Block"
  },
  "Template": {
    "prefix": "template",
    "body": [
      "<template>",
      "\t<div>",
      "\t\t${0}",
      "\t</div>",
      "</template>"
