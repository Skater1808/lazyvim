{
  "Flexbox": {
    "prefix": "flex",
    "body": [
      "display: flex;",
      "align-items: ${1:center};",
      "justify-content: ${2:center};",
      "gap: ${3:1rem};"
    ],
    "description": "Flex-Container"
  },
  "Grid": {
    "prefix": "grid",
    "body": [
      "display: grid;",
      "grid-template-columns: repeat(${1:3}, minmax(0, 1fr));",
      "gap: ${2:1rem};"
    ],
    "description": "Grid-Container"
  },
  "Absolute center": {
    "prefix": "center",
    "body": [
      "position: absolute;",
      "top: 50%;",
      "left: 50%;",
      "transform: translate(-50%, -50%);"
    ],
    "description": "Element absolut zentrieren"
  },
  "Media query": {
    "prefix": "media",
    "body": [
      "@media (max-width: ${1:768px}) {",
      "\t${0}",
      "}"
    ],
    "description": "Responsive Media Query"
  },
  "Keyframes": {
    "prefix": "keyframes",
    "body": [
      "@keyframes ${1:name} {",
      "\tfrom {",
      "\t\t${2:opacity: 0;}",
      "\t}",
      "\tto {",
      "\t\t${3:opacity: 1;}",
      "\t}",
      "}"
    ],
    "description": "Animation Keyframes"
  },
  "Transition": {
    "prefix": "transition",
    "body": [
      "transition: ${1:all} ${2:0.2s} ${3:ease};"
    ],
    "description": "Transition"
  },
  "Box shadow": {
    "prefix": "shadow",
    "body": [
      "box-shadow: 0 ${1:4px} ${2:12px} ${3:rgba(0, 0, 0, 0.15)};"
    ],
    "description": "Box-Shadow"
  },
  "CSS variable": {
    "prefix": "var",
    "body": [
      "--${1:name}: ${2:value};"
    ],
    "description": "Custom Property definieren"
  },
  "Font face": {
    "prefix": "fontface",
    "body": [
      "@font-face {",
      "\tfont-family: \"${1:Name}\";",
      "\tsrc: url(\"${2:file.woff2}\") format(\"woff2\");",
      "\tfont-weight: ${3:400};",
      "\tfont-style: normal;",
      "\tfont-display: swap;",
      "}"
    ],
    "description": "Webfont einbinden"
  },
  "Dark mode": {
    "prefix": "dark",
    "body": [
      "@media (prefers-color-scheme: dark) {",
      "\t${0}",
      "}"
    ],
    "description": "Dark-Mode Media Query"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "@import url(\"${1:style.css}\");"
    ],
    "description": "CSS importieren"
  }
}
