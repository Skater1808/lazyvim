{
  "Function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:args}) -> ${3:None}:",
      "\t\"\"\"${4:Summary.}\"\"\"",
      "\t${0}"
    ],
    "description": "Funktion mit Docstring"
  },
  "Async function": {
    "prefix": "adef",
    "body": [
      "async def ${1:name}(${2:args}) -> ${3:None}:",
      "\t${0}"
    ],
    "description": "Asynchrone Funktion"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "\tdef __init__(self, ${2:args}) -> None:",
      "\t\tself.${3:attr} = ${4:value}",
      "\t\t${0}"
    ],
    "description": "Klasse mit Konstruktor"
  },
  "Main guard": {
    "prefix": "main",
    "body": [
      "if __name__ == \"__main__\":",
      "\t${1:main()}"
    ],
    "description": "Main-Guard"
  },
  "Try except": {
    "prefix": "try",
    "body": [
      "try:",
      "\t${1:pass}",
      "except ${2:Exception} as ${3:exc}:",
      "\t${4:raise}"
    ],
    "description": "Try/Except-Block"
  },
  "With": {
    "prefix": "with",
    "body": [
      "with open(\"${1:file}\") as ${2:f}:",
      "\t${0}"
    ],
    "description": "Kontextmanager"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}:",
      "\t${0}"
    ],
    "description": "For-Schleife"
  },
  "List comprehension": {
    "prefix": "comp",
    "body": [
      "[${1:expression} for ${2:item} in ${3:items}]"
    ],
    "description": "List Comprehension"
  },
  "Dataclass": {
    "prefix": "dataclass",
    "body": [
      "from dataclasses import dataclass",
      "",
      "",
      "@dataclass",
      "class ${1:Name}:",
      "\t${2:field}: ${3:str}"
    ],
    "description": "Dataclass"
  },
  "Pytest test": {
    "prefix": "pytest",
    "body": [
      "def test_${1:name}():",
      "\t${2:assert True}"
    ],
    "description": "Pytest-Testfunktion"
  },
  "Print f-string": {
    "prefix": "print",
    "body": [
      "print(f\"${1:message}\")"
    ],
    "description": "f-String-Ausgabe"
  },
  "Dict comprehension": {
    "prefix": "dcomp",
    "body": [
      "{${1:key}: ${2:value} for ${3:item} in ${4:items}}"
    ],
    "description": "Dict Comprehension"
  }
}
